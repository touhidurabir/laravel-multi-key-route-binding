{
    "name": "touhidurabir/laravel-multi-key-route-binding",
    "description": "A simple laravel package to handle multiple key based model route binding",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Touhidur Rahman",
            "email": "abircse06@gmail.com"
        }
    ],
    "autoload" : {
        "psr-4" : {
            "Touhidurabir\\MultiKyeRouteBinding\\": "src/"
        }
    },
    "autoload-dev" : {
        "psr-4" : {
            "Touhidurabir\\MultiKyeRouteBinding\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5||^10.0||^11.0||^12.0",
        "orchestra/testbench": "^6.20||^7.0||^8.0||^9.0||^10.0||^11.0",
        "illuminate/support": "^8.54||^9.0||^10.0||^11.0||^12.0||^13.0",
        "laravel/pint": "^1.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Touhidurabir\\MultiKyeRouteBinding\\MultiKyeRouteBindingServiceProvider"
            ],
            "aliases": {
                "MultiKyeRouteBinding": "Touhidurabir\\MultiKyeRouteBinding\\Facades\\MultiKyeRouteBinding"
            }
        }
    },
    "scripts": {
        "format": "pint",
        "lint": "pint --test"
    }
}
